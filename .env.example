SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
LICHESS_TOKEN=
LICHESS_USERNAME=
CHESSCOM_USERNAME=
STOCKFISH_PATH=
STOCKFISH_DEPTH=16
GEMINI_RATE_LIMIT_SLEEP_SEC=2
TESSERACT_PATH=
POPPLER_PATH=
# Formato: "nome1:chave1,nome2:chave2" (uma chave por pessoa; o nome é só um
# rótulo de log). API_SECRET_KEY (singular) ainda funciona como fallback
# ("eu:valor") se API_SECRET_KEYS não estiver definida.
API_SECRET_KEYS=

# Dono único dos dados enquanto o Supabase Auth não entra (Fase B).
# Toda tabela raiz grava este UUID em user_id — ver D-14 em docs/DECISOES.md.
DEFAULT_USER_ID=

# Limite diário por usuário nas 4 rotas caras (Stockfish/Gemini) — opcionais,
# cada uma tem default no código (20/50/50/30). Só precisam ir aqui quando o
# valor precisar mudar sem novo deploy — ver D-32 em docs/DECISOES.md.
LIMITE_DIARIO_ANALISAR_PGN=
LIMITE_DIARIO_EXPLICAR_POSICAO=
LIMITE_DIARIO_REVISAR_AVULSO=
LIMITE_DIARIO_RECONHECER_POSICAO=

# OAuth do Lichess (D-33) — todas opcionais, com default no código. Nenhuma é
# segredo: o Lichess usa cliente público, sem client_secret e sem registro
# prévio. O REDIRECT_URI precisa bater exatamente entre autorizar e trocar o
# código, então é o que muda entre local e produção.
LICHESS_OAUTH_CLIENT_ID=
LICHESS_OAUTH_REDIRECT_URI=
LICHESS_OAUTH_SCOPES=
FRONTEND_URL=
